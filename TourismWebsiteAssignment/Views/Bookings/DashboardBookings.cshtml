
@{
    ViewBag.Title = "DashboardBookings";
}

@model IEnumerable<TourismWebsiteAssignment.Models.Booking>

<div class="dashboard-section">

    <h2>Bookings</h2>
    <p class="section-subtitle">Manage and track all customer bookings</p>

    <div class="table-container">
        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Tourist</th>
                    <th>Package</th>
                    <th>Tour Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Tourist.FullName</td>
                        <td>@booking.TourDate.TravelPackage.PackageTitle</td>
                        <td>@booking.TourDate.StartDate.ToShortDateString()</td>
                        <td>
                            <span class="status">@booking.BookingStatus.StatusName</span>
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Bookings", new { id = booking.BookingId })" class="btn btn-view">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>


