@model TourismWebsiteAssignment.Models.TouristProfile

@{
    ViewBag.Title = "Create Profile";
}

<link rel="stylesheet" href="~/Content/CustomStyles/CreateUser.css" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="auth-card">

        <div class="auth-header">
            <h2>Complete Your Profile</h2>
            <p class="auth-subtitle">
                Provide your details to finish setting up your tourist account.
            </p>
        </div>

        @* Validation summary styled with CreateUser.css *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="form-error">
                @Html.ValidationSummary(true, "", new { })
            </div>
        }

        @Html.HiddenFor(m => m.UserId)

        <div class="form-field">
            @Html.LabelFor(m => m.FullName)
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-input", placeholder = "e.g., John Smith" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.Gender)
            @Html.DropDownListFor(
                m => m.Gender,
                new SelectList(new[]
                {
                    new { Value = "", Text = "Select gender" },
                    new { Value = "Male", Text = "Male" },
                    new { Value = "Female", Text = "Female" },
                    new { Value = "Other", Text = "Other" }
                }, "Value", "Text", Model.Gender),
                new { @class = "form-select" }
            )
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.DateOfBirth)
            @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-input", type = "date" })
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.Address)
            @Html.TextBoxFor(m => m.Address, new { @class = "form-input", placeholder = "Street, suburb, city" })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.Nationality)
            @Html.TextBoxFor(m => m.Nationality, new { @class = "form-input", placeholder = "e.g., Nepali, Australian" })
            @Html.ValidationMessageFor(m => m.Nationality, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.TravelPreferences)
            @Html.TextAreaFor(m => m.TravelPreferences, new { @class = "form-input", rows = 3, placeholder = "e.g., hiking, beaches, budget travel" })
            @Html.ValidationMessageFor(m => m.TravelPreferences, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelFor(m => m.ProfileImageUrl)
            @Html.TextBoxFor(m => m.ProfileImageUrl, new { @class = "form-input", placeholder = "Image URL (optional)" })
            @Html.ValidationMessageFor(m => m.ProfileImageUrl, "", new { @class = "field-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Save Profile</button>
        </div>

        <div class="auth-footer">
            @Html.ActionLink("Back", "Index", null, new { @class = "link-muted" })
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
