@model TourismWebsiteAssignment.Models.PaymentTransactions

@{
    ViewBag.Title = "Make Payment";
}

<link rel="stylesheet" href="~/Content/CustomStyles/PaymentGateway.css" />

<section class="payment-page">
    <div class="payment-grid">

        <!-- Main Payment Card -->
        <div class="payment-card">
            <div class="payment-card__header">
                <div>
                    <h2 class="payment-title">Secure Checkout</h2>
                    <p class="payment-subtitle">Select a payment method and enter details for demo purposes.</p>
                </div>
            </div>

            <div class="payment-card__body">
                @using (Html.BeginForm("Create", "PaymentTransactions", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.HiddenFor(m => m.BookingId)

                    <div class="field">
                        <label>Total Amount</label>
                        <input class="pg-input"
                               value="@($"{ViewBag.Currency} {ViewBag.Amount:0.00}")"
                               readonly />
                    </div>

                    <div class="field">
                        @Html.LabelFor(m => m.PaymentMethod, "Payment Method")
                        @Html.DropDownListFor(
                            m => m.PaymentMethod,
                            (SelectList)ViewBag.PaymentMethod,
                            "Select payment method",
                            new { @class = "pg-select", id = "PaymentMethod" }
                        )
                        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
                    </div>

                    <!-- Card details (UI only) -->
                    <div id="card-details" class="card-details">
                        <div class="field">
                            <label>Card Number</label>
                            <input type="text" class="pg-input" placeholder="1234 5678 9012 3456" maxlength="19" />
                        </div>

                        <div class="card-details__grid">
                            <div class="field">
                                <label>Cardholder Name</label>
                                <input type="text" class="pg-input" placeholder="Name on card" />
                            </div>

                            <div class="field">
                                <label>Expiry</label>
                                <input type="text" class="pg-input" placeholder="MM/YY" maxlength="5" />
                            </div>

                            <div class="field">
                                <label>CVV</label>
                                <input type="password" class="pg-input" placeholder="123" maxlength="4" />
                            </div>
                        </div>
                    </div>

                    <div class="pg-actions">
                        <button type="submit" class="pg-btn pg-btn--primary">
                            Pay @($"{ViewBag.Currency} {ViewBag.Amount:0.00}")
                        </button>

                        <a class="pg-btn pg-btn--ghost" href="@Url.Action("Index", "Tourist")">
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Summary Sidebar -->
        <aside class="payment-summary">
            <div class="summary-title">Order Summary</div>

            <div class="summary-row">
                <div class="summary-key">Currency</div>
                <div class="summary-val">@ViewBag.Currency</div>
            </div>

            <div class="summary-row">
                <div class="summary-key">Total</div>
                <div class="summary-val">@($"{ViewBag.Currency} {ViewBag.Amount:0.00}")</div>
            </div>

            <div class="summary-row">
                <div class="summary-key">Security</div>
                <div class="summary-val">Demo UI</div>
            </div>
        </aside>

    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const paymentSelect = document.getElementById("PaymentMethod");
            const cardDetails = document.getElementById("card-details");

            function toggleCardDetails() {
                const v = paymentSelect ? paymentSelect.value : "";
                cardDetails.style.display = (v && v !== "") ? "block" : "none";
            }

            if (paymentSelect) {
                paymentSelect.addEventListener("change", toggleCardDetails);
                toggleCardDetails();
            }
        });
    </script>
}
