@model TourismWebsiteAssignment.Models.PackageImage

@{
    ViewBag.Title = "Add Package Image";
}

<link rel="stylesheet" href="~/Content/CustomStyles/CreateUser.css" />

<section class="auth-card">
    <header class="auth-header">
        <h2>Add Package Image</h2>
        <p class="auth-subtitle">Select a package and add an image URL with an optional caption.</p>
    </header>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "form-error" })

        <!-- Package -->
        <div class="form-field">
            @Html.LabelFor(m => m.PackageId, "Package")
            @Html.DropDownList("PackageId", null, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.PackageId, "", new { @class = "field-error" })
        </div>

        <!-- Image URL -->
        <div class="form-field">
            @Html.LabelFor(m => m.ImageURL, "Image URL")
            @Html.TextBoxFor(m => m.ImageURL, new { @class = "form-input", placeholder = "https://example.com/image.jpg" })
            @Html.ValidationMessageFor(m => m.ImageURL, "", new { @class = "field-error" })
        </div>

        <!-- Caption -->
        <div class="form-field">
            @Html.LabelFor(m => m.Caption)
            @Html.TextBoxFor(m => m.Caption, new { @class = "form-input", placeholder = "Optional caption (e.g., Beach view)" })
            @Html.ValidationMessageFor(m => m.Caption, "", new { @class = "field-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create</button>
        </div>
    }

    <footer class="auth-footer">
        <a class="link-muted" href="@Url.Action("Index")">Back to List</a>
    </footer>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
