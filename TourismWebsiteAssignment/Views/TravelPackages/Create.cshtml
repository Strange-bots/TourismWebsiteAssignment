@model TourismWebsiteAssignment.Models.TravelPackage

@{
    ViewBag.Title = "Create Travel Package";
}

<link rel="stylesheet" href="~/Content/CustomStyles/CreateUser.css" />

<section class="auth-card">
    <header class="auth-header">
        <h2>Create Travel Package</h2>
        <p class="auth-subtitle">Add a new package with details, pricing, and policies.</p>
    </header>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @* Validation summary styled by .form-error *@
        @Html.ValidationSummary(true, "", new { @class = "form-error" })

        <!-- Agency -->
<div class="form-field">
    @Html.HiddenFor(m => m.AgencyId)

</div>

        <!-- Package Title -->
        <div class="form-field">
            @Html.LabelFor(m => m.PackageTitle)
            @Html.TextBoxFor(m => m.PackageTitle, new { @class = "form-input", placeholder = "e.g., 5-Day Sydney Explorer" })
            @Html.ValidationMessageFor(m => m.PackageTitle, "", new { @class = "field-error" })
        </div>

        <!-- Package Description -->
        <div class="form-field">
            @Html.LabelFor(m => m.PackageDescription)
            @Html.TextAreaFor(m => m.PackageDescription, 4, 0, new { @class = "form-input", placeholder = "Describe the package highlights, duration, and experience." })
            @Html.ValidationMessageFor(m => m.PackageDescription, "", new { @class = "field-error" })
        </div>

        <!-- Destination -->
        <div class="form-field">
            @Html.LabelFor(m => m.Destination)
            @Html.TextBoxFor(m => m.Destination, new { @class = "form-input", placeholder = "e.g., Sydney, NSW" })
            @Html.ValidationMessageFor(m => m.Destination, "", new { @class = "field-error" })
        </div>

        <!-- Price Per Person -->
        <div class="form-field">
            @Html.LabelFor(m => m.PricePerPerson)
            @Html.TextBoxFor(m => m.PricePerPerson, new { @class = "form-input", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
            @Html.ValidationMessageFor(m => m.PricePerPerson, "", new { @class = "field-error" })
        </div>

        <!-- Group Max Size -->
        <div class="form-field">
            @Html.LabelFor(m => m.GroupMaxSize)
            @Html.TextBoxFor(m => m.GroupMaxSize, new { @class = "form-input", type = "number", step = "1", min = "1", placeholder = "e.g., 20" })
            @Html.ValidationMessageFor(m => m.GroupMaxSize, "", new { @class = "field-error" })
        </div>

        <!-- Inclusions -->
        <div class="form-field">
            @Html.LabelFor(m => m.Inclusions)
            @Html.TextAreaFor(m => m.Inclusions, 3, 0, new { @class = "form-input", placeholder = "e.g., Hotel, breakfast, airport transfer..." })
            @Html.ValidationMessageFor(m => m.Inclusions, "", new { @class = "field-error" })
        </div>

        <!-- Exclusions -->
        <div class="form-field">
            @Html.LabelFor(m => m.Exclusions)
            @Html.TextAreaFor(m => m.Exclusions, 3, 0, new { @class = "form-input", placeholder = "e.g., Flights, personal expenses..." })
            @Html.ValidationMessageFor(m => m.Exclusions, "", new { @class = "field-error" })
        </div>

        <!-- Itinerary -->
        <div class="form-field">
            @Html.LabelFor(m => m.ItineraryDetails)
            @Html.TextAreaFor(m => m.ItineraryDetails, 5, 0, new { @class = "form-input", placeholder = "Day-by-day itinerary details." })
            @Html.ValidationMessageFor(m => m.ItineraryDetails, "", new { @class = "field-error" })
        </div>

        <!-- Terms -->
        <div class="form-field">
            @Html.LabelFor(m => m.TermsAndConditions)
            @Html.TextAreaFor(m => m.TermsAndConditions, 4, 0, new { @class = "form-input", placeholder = "Cancellation policy, eligibility, conditions..." })
            @Html.ValidationMessageFor(m => m.TermsAndConditions, "", new { @class = "field-error" })
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Package</button>
        </div>
    }

    <footer class="auth-footer">
        <a class="link-muted" href="@Url.Action("AgentMyPackages","TravelPackages")">Back to List</a>
        <span style="opacity:.6;">&nbsp;|&nbsp;</span>
        <a class="link-muted" href="@Url.Action("AgentMyPackages")">Cancel</a>
    </footer>
</section>
