@model TourismWebsiteAssignment.Models.TourDate

@{
    ViewBag.Title = "Edit Tour Date";
}
<link rel="stylesheet" href="~/Content/CustomStyles/Edit.css" />
@Html.HiddenFor(m=>m.PackageId)
<section class="admin-page">

    <!-- Page Header -->
    <header class="admin-page__header">
        <div>
            <h1 class="admin-page__title">Edit Tour Date</h1>
            <p class="admin-page__subtitle">Update schedule, pricing, and availability</p>
        </div>
    </header>

    <!-- Card -->
    <div class="admin-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title">Tour Date Details</h2>
            <p class="admin-card__hint">All fields are required unless stated otherwise</p>
        </div>

        <div class="admin-card__body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "form-error-summary" })
                @Html.HiddenFor(model => model.TourDateId)

                <div class="form-grid">
                    <!-- Start Date -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.StartDate, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.StartDate,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "form-error" })
                    </div>

                    <!-- End Date -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.EndDate, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.EndDate,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "form-error" })
                    </div>

                    <!-- Available Slots -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.AvailableSlots, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.AvailableSlots,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.AvailableSlots, "", new { @class = "form-error" })
                    </div>

                    <!-- Total Slots -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.TotalSlots, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.TotalSlots,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.TotalSlots, "", new { @class = "form-error" })
                    </div>

                    <!-- Status -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.Status, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.Status,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.Status, "", new { @class = "form-error" })
                    </div>

                    <!-- Price Adjustment -->
                    <div class="form-field">
                        @Html.LabelFor(m => m.PriceAdjustment, new { @class = "form-label" })
                        @Html.EditorFor(
                            m => m.PriceAdjustment,
                            new { htmlAttributes = new { @class = "form-input" } }
                        )
                        @Html.ValidationMessageFor(m => m.PriceAdjustment, "", new { @class = "form-error" })
                    </div>

                </div>

                <!-- Actions -->
                <div class="form-actions">
                    <a href="@Url.Action("AgentMyTours")" class="btn btn--ghost">Cancel</a>
                    <button type="submit" class="btn btn--primary">Save Changes</button>
                </div>
            }

        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
