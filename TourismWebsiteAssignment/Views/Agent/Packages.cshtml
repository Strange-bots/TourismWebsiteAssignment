@{
ViewBag.Title = "Packages";
}
<div class="dashboard-section">

    <div class="section-header">
        <h2>My Packages</h2>
        <button class="btn btn-add">+ Create New Package</button>
    </div>

    <p class="section-subtitle">Manage your travel packages and offerings</p>

    <div class="table-container">
        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Package ID</th>
                    <th>Package Name</th>
                    <th>Destination</th>
                    <th>Price / Person</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>#P001</td>
                    <td>Bali Getaway</td>
                    <td>Bali, Indonesia</td>
                    <td>$1,200</td>
                    <td><span class="status active">Active</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Edit</button>
                        <button class="btn btn-delete">Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>#P002</td>
                    <td>Nepal Trek Adventure</td>
                    <td>Kathmandu, Nepal</td>
                    <td>$1,800</td>
                    <td><span class="status inactive">Inactive</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Edit</button>
                        <button class="btn btn-delete">Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>#P003</td>
                    <td>Japan Explorer</td>
                    <td>Tokyo, Japan</td>
                    <td>$2,400</td>
                    <td><span class="status active">Active</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Edit</button>
                        <button class="btn btn-delete">Delete</button>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

</div>
