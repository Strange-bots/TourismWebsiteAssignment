    <nav class="nav">
        <!-- Left: Hamburger (always visible) -->
        <div class="nav-left">
            <input type="checkbox" id="navToggle" class="nav-toggle" />
            <label for="navToggle" class="hamburger" aria-label="Toggle navigation" title="Menu">
                <span></span>
                <span></span>
                <span></span>
            </label>

            <!-- Dropdown menu -->
            <div class="nav-dropdown" role="menu" aria-label="Navigation menu">
                <ul>
                <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                <li>@Html.ActionLink("About", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                <li>@Html.ActionLink("Browse", "Package", "TravelPackagfe", new { area = "" }, new { @class = "nav-link" })</li>
                <li>@Html.ActionLink("Contact", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>
            </div>
        </div>

        <!-- Center: Search bar -->
        <div class="nav-center">
            <form class="nav-search" action="#" method="get">
                <input type="text" name="q" placeholder="Search packages, destinations..." />
                <button type="submit">Search</button>
            </form>
        </div>

        <!-- Right: Company logo -->
        <div class="nav-right">
            <a href="#" class="brand">
                <img src="/Content/images/logo.png" alt="Company Logo" class="brand-logo" />
            </a>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
