@model IEnumerable<TourismWebsiteAssignment.Models.User>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Users.css" />

<section class="admin-page">

    <header class="admin-header">
        <div>
            <h2 class="admin-title">User Management</h2>
            <p class="admin-subtitle">View and manage system users.</p>
        </div>

        <div class="admin-actions">
            @Html.ActionLink("Create New User", "Create", null, new { @class = "btn btn--primary" })
        </div>
    </header>

    <div class="card-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var u in Model)
            {
                <article class="entity-card">
                    <div class="entity-card__top">
                        <div>
                            <h3 class="entity-card__title">@u.FullName</h3>
                            <p class="entity-card__meta">
                               
                                <span class="dot">•</span>
                                <span class="muted">@u.Username</span>
                            </p>
                        </div>

                        <div class="avatar">
                            @(string.IsNullOrWhiteSpace(u.FullName) ? "U" : u.FullName.Trim().Substring(0, 1).ToUpper())
                        </div>
                    </div>

                    <div class="entity-card__body">
                        <div class="kv">
                            <span class="kv__k">Email</span>
                            <span class="kv__v kv__v--mono">@u.Email</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Username</span>
                            <span class="kv__v">@u.Username</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Password</span>
                            <span class="kv__v text-muted">Hidden</span>
                        </div>
                    </div>

                    <footer class="entity-card__footer">
                        <a class="btn btn--ghost" href="@Url.Action("Details", new { id = u.UserId })">Details</a>
                        <a class="btn btn--ghost" href="@Url.Action("Edit", new { id = u.UserId })">Edit</a>
                        <a class="btn btn--danger" href="@Url.Action("Delete", new { id = u.UserId })">Delete</a>
                    </footer>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <h3 class="empty-state__title">No users found</h3>
                <p class="empty-state__text">Create a user to see it listed here.</p>
            </div>
        }
    </div>

</section>
