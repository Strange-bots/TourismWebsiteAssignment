@model IEnumerable<TourismWebsiteAssignment.Models.Booking>

@{
    ViewBag.Title = "Bookings";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">Bookings</h2>
            <p class="page-subtitle">View and manage customer bookings.</p>
        </div>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="grid">
            @foreach (var item in Model)
            {
                <article class="card">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title">@item.TourDate.TravelPackage.PackageTitle </h3>
                            <p class="card-meta">
                                <span class="badge">@item.BookingStatus.StatusName</span>
                                <span class="separator">•</span>
                                <span class="muted">Tour: @item.TourDate.Status</span>
                            </p>
                        </div>

                        <div class="price">
                            <span class="price-label">Total</span>
                            <span class="price-value">
                                @String.Format("{0:C}", item.TotalPrice)
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="field">
                            <span class="field-label">Tourist</span>
                            <span class="field-value">@item.Tourist.FullName</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Booking Date</span>
                            <span class="field-value">@item.BookingDate</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Guests</span>
                            <span class="field-value">@item.NumberOfGuests</span>
                        </div>

                        <div class="field field-full">
                            <span class="field-label">Special Status</span>
                            <span class="field-value clamp-2">@item.SpecialStatus</span>
                        </div>
                    </div>

                    <footer class="card-footer">
                        <a class="btn btn-ghost" href="@Url.Action("Details", new { id = item.BookingId })">Details</a>
                        <a class="btn btn-ghost" href="@Url.Action("Edit", new { id = item.BookingId })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.BookingId })">Delete</a>
                    </footer>

                </article>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <h3>No bookings found</h3>
            <p>Bookings will appear here once customers start booking tours.</p>
        </div>
    }

</section>
