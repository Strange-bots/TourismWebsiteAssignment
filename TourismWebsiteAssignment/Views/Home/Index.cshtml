@model IEnumerable<TourismWebsiteAssignment.Models.Booking>
@using System.Linq

@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Home-page.css" />

<main class="home">

    <!-- HERO -->
    <header class="hero">
        <div class="hero__bg" aria-hidden="true"></div>

        <div class="container hero__inner">
            <div class="hero__panel">
                <span class="pill">WanderLust • Mountain Collection</span>

                <h1 class="hero__title">
                    Discover Nepal’s <span class="accent">Mountain Trails</span> and Hidden Wonders
                </h1>

                <p class="hero__lead">
                    Curated journeys built for real landscapes: high passes, lakes, villages, and unforgettable views.
                    Plan, book, and travel with confidence.
                </p>

                <div class="hero__actions">
                    <a class="btn btn--primary" href="@Url.Action("Index","TravelPackages")">Explore Tours</a>
                    <a class="btn btn--ghost" href="@Url.Action("Contact", "Home")">Contact Us</a>
                </div>

                <div class="hero__meta">
                    <div class="meta">
                        <span class="meta__k">Season</span>
                        <span class="meta__v">All year</span>
                    </div>
                    <div class="meta">
                        <span class="meta__k">Support</span>
                        <span class="meta__v">24/7</span>
                    </div>
                    <div class="meta">
                        <span class="meta__k">Safety</span>
                        <span class="meta__v">Verified routes</span>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- FEATURED TOURS -->
    <section class="section">
        <div class="container">
            <div class="section__head">
                <div>
                    <h2 class="section__title">Past Tours that were popular</h2>
                    <p>This tours May not be avialable now</p>
                    <p class="section__sub">Hand-picked mountain experiences that travelers consistently rate highly.</p>
                </div>

                <a class="btn btn--dark" href="@Url.Action("Index", "TravelPackages")">View All Tours</a>
            </div>

            <div class="cards">
                <article class="card">
                    <div class="card__media">
                        <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1400&q=80"
                             alt="Mountain tour destination" />
                        <span class="chip">5 days</span>
                    </div>

                    <div class="card__body">
                        <h3 class="card__title">Mountain Escape</h3>
                        <p class="card__meta">Hiking • Lakes • Local guides</p>
                        <p class="card__text">Explore alpine trails, scenic lakes, and cozy stays with experienced guides.</p>
                    </div>

                    <div class="card__foot">
                        <div class="price">
                            <span class="price__k">From</span>
                            <span class="price__v">$799</span>
                            </div>
                        </div>
                </article>

                <article class="card">
                    <div class="card__media">
                        <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=80"
                             alt="Snowy mountain adventure" />
                        <span class="chip">3 days</span>
                    </div>

                    <div class="card__body">
                        <h3 class="card__title">Alpine Adventure</h3>
                        <p class="card__meta">Snow • Photography</p>
                        <p class="card__text">A short alpine trip designed for breathtaking views and iconic photos.</p>
                    </div>

                    <div class="card__foot">
                        <div class="price">
                            <span class="price__k">From</span>
                            <span class="price__v">$499</span>
                        </div>
                        </div>
                </article>

                <article class="card">
                    <div class="card__media">
                        <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1400&q=80"
                             alt="Forest and mountains" />
                        <span class="chip">7 days</span>
                    </div>

                    <div class="card__body">
                        <h3 class="card__title">Nature Retreat</h3>
                        <p class="card__meta">Relax • Nature • Comfort stays</p>
                        <p class="card__text">Slow travel for calm minds: comfortable stays and curated day trips.</p>
                    </div>

                    <div class="card__foot">
                        <div class="price">
                            <span class="price__k">From</span>
                            <span class="price__v">$999</span>
                        </div>
                        </div>
                </article>
            </div>
        </div>
    </section>

    <!-- PROJECT TEAM -->
    <section class="project-team">
        <header class="section-header">
            <h2 class="title-font">Project Team</h2>
            <p class="subheading">Meet the students behind this tourism website prototype</p>
        </header>

        <table class="team-table" aria-label="Project Team Table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Student ID</th>
                    <th>Role</th>
                    <th>Contribution on the Coding of MVC</th>
                    <th>GithubName</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Sachin Thapa</td>
                    <td>20028232</td>
                    <td>Web Design &amp; Development</td>
                    <td>100%</td>
                    <td>Strange-bots</td>
                </tr>

                <tr>
                    <td>Manihang Limbu</td>
                    <td>20031286</td>
                    <td>Project Report Cordinator</td>
                    <td>70%</td>
                    <td>Strange-bots</td>
                </tr>

                <tr>
                    <td>Samir Adhikari</td>
                    <td>20026676</td>
                    <td>Report &amp; Design analyis(UI/UX Designer)</td>
                    <td>40%</td>
                    <td>Strange-bots</td>
                </tr>

                <tr>
                    <td>Salin Maharjan</td>
                    <td>20024393</td>
                    <td>Requirement Analysis and buddy Coder</td>
                    <td>40%</td>
                    <td>Strange-bots</td>
                </tr>

                <tr>
                    <td>Rohan Maharasi</td>
                    <td>20030949</td>
                    <td>Report Analysis</td>
                    <td>40%</td>
                    <td>Strange-bots</td>
                </tr>
            </tbody>
        </table>
    </section>


    <!-- CTA (MANDATORY, KEPT + UPGRADED) -->
    <section class="cta">
        <div class="container">
            <div class="cta__card">
                <div class="cta__copy">
                    <h2 class="cta__title">Ready to Start Your Adventure?</h2>
                    <p class="cta__text">
                        Join thousands of travelers discovering remarkable destinations. Create an account or browse tours to begin.
                    </p>
                </div>

                <div class="cta__actions">
                    <a class="btn btn--primary" href="@Url.Action("Index", "LoginRegistration")">Create Account</a>
                    <a class="btn btn--dark" href="@Url.Action("Index", "TravelPackages")">Browse Tours</a>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer__grid">
            <div>
                <h3 class="footer__title">WanderLust</h3>
                <p class="footer__text">Curated tours. Real experiences. Safer travel.</p>
            </div>

            <div>
                <h3 class="footer__title">Contact</h3>
                <p class="footer__text">Email: support@wanderlust.test</p>
                <p class="footer__text">Sydney, Australia</p>
            </div>
        </div>

        <div class="container footer__bottom">
            <p>2025 WanderLust Tourism. All rights reserved.</p>
        </div>
    </footer>

</main>

