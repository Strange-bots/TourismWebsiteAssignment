@model TourismWebsiteAssignment.Models.Booking

@{
    ViewBag.Title = "Delete";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Delete.css" />
<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<h2>Delete</h2>

<div class="card--danger" style="background:#fff; border-radius:16px; padding:20px;">

    <div class="alert alert-danger">
        Are you sure you want to delete this Booking?
        <span class="alert-badge">Permanent</span>
    </div>

    <dl class="details">

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.BookingStatus.StatusName)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.BookingStatus.StatusName)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.TourDate.Status)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.TourDate.Status)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.Tourist.FullName)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.Tourist.FullName)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.BookingDate)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.BookingDate)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.NumberOfGuests)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.NumberOfGuests)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.TotalPrice)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.TotalPrice)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.SpecialStatus)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.SpecialStatus)</dd>
        </div>

    </dl>

    <div style="margin-top:16px; display:flex; gap:10px; align-items:center;">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Delete" class="btn btn-danger" />
        }
    </div>

</div>
