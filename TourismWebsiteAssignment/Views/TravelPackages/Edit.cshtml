@model TourismWebsiteAssignment.Models.TravelPackage

@{
    ViewBag.Title = "Edit Package";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Edit.css">

<section class="admin-page">

    <header class="admin-page__header">
        <div>
            <h2 class="admin-page__title">Edit Travel Package</h2>
            <p class="admin-page__subtitle">Update package information and save changes.</p>
        </div>

        <div class="admin-page__actions">
            <a class="btn btn--ghost" href="@Url.Action("AgentMyPackages","TravelPackages")">Back to List</a>
        </div>
    </header>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.PackageId)
        @Html.HiddenFor(m => m.AgencyId)

        <div class="admin-card">

            <div class="admin-card__header">
                <h3 class="admin-card__title">@Model.PackageTitle</h3>
                <p class="admin-card__hint">Edit the details below.</p>
            </div>

            <div class="admin-card__body">

                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(true, "", new { @class = "form-error-summary" })
                }

                <div class="form-grid">

                    <div class="form-field">
                        <label class="form-label">@Html.DisplayNameFor(m => m.PackageTitle)</label>
                        @Html.TextBoxFor(m => m.PackageTitle, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.PackageTitle, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field" style="grid-column: 1 / -1;">
                        <label class="form-label">@Html.DisplayNameFor(m => m.PackageDescription)</label>
                        @Html.TextAreaFor(m => m.PackageDescription, 4, 60, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.PackageDescription, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Destination)</label>
                        @Html.TextBoxFor(m => m.Destination, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.Destination, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field">
                        <label class="form-label">@Html.DisplayNameFor(m => m.PricePerPerson)</label>
                        @Html.TextBoxFor(m => m.PricePerPerson, new { @class = "form-input", type = "number", step = "0.01", min = "0" })
                        @Html.ValidationMessageFor(m => m.PricePerPerson, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field">
                        <label class="form-label">@Html.DisplayNameFor(m => m.GroupMaxSize)</label>
                        @Html.TextBoxFor(m => m.GroupMaxSize, new { @class = "form-input", type = "number", min = "1" })
                        @Html.ValidationMessageFor(m => m.GroupMaxSize, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field" style="grid-column: 1 / -1;">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Inclusions)</label>
                        @Html.TextAreaFor(m => m.Inclusions, 3, 60, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.Inclusions, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field" style="grid-column: 1 / -1;">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Exclusions)</label>
                        @Html.TextAreaFor(m => m.Exclusions, 3, 60, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.Exclusions, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field" style="grid-column: 1 / -1;">
                        <label class="form-label">@Html.DisplayNameFor(m => m.ItineraryDetails)</label>
                        @Html.TextAreaFor(m => m.ItineraryDetails, 4, 60, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.ItineraryDetails, "", new { @class = "form-error" })
                    </div>

                    <div class="form-field" style="grid-column: 1 / -1;">
                        <label class="form-label">@Html.DisplayNameFor(m => m.TermsAndConditions)</label>
                        @Html.TextAreaFor(m => m.TermsAndConditions, 4, 60, new { @class = "form-input" })
                        @Html.ValidationMessageFor(m => m.TermsAndConditions, "", new { @class = "form-error" })
                    </div>


                </div>

                <div class="form-actions">
                    <a class="btn btn--ghost" href="@Url.Action("AgentMyPackages","TravelPackages")">Cancel</a>
                    <input type="submit" value="Save Changes" class="btn btn--primary" />
                </div>

            </div>
        </div>
    }

</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
