<style>
    .agent-account-basic {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px;
    }

    .agent-account-basic__header {
        margin-bottom: 22px;
    }

    .agent-account-basic__title {
        font-size: 1.6rem;
        margin-bottom: 4px;
    }

    .agent-account-basic__subtitle {
        font-size: 0.95rem;
        color: #666;
    }

    /* Summary box */
    .agent-summary {
        background: #ffffff;
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }

    .agent-summary--muted {
        background: #fafafa;
    }

    /* Rows */
    .agent-summary__row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

        .agent-summary__row:last-child {
            border-bottom: none;
        }

    .agent-summary__label {
        color: #777;
        font-size: 0.9rem;
    }

    .agent-summary__value {
        font-weight: 600;
        color: #333;
    }

    /* Status */
    .agent-summary__value--active {
        color: #2e7d32;
    }

    /* Note */
    .agent-summary__note {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
        line-height: 1.5;
    }

</style>
<div class="agent-account-basic">

    <!-- Header -->
    <header class="agent-account-basic__header">
        <h2 class="agent-account-basic__title">My Account</h2>
        <p class="agent-account-basic__subtitle">
            Basic account information.
        </p>
    </header>

    <!-- Account Summary -->
    <section class="agent-summary">
        <div class="agent-summary__row">
            <span class="agent-summary__label">Account Name</span>
            <span class="agent-summary__value">Agent User</span>
        </div>

        <div class="agent-summary__row">
            <span class="agent-summary__label">Role</span>
            <span class="agent-summary__value">Travel Agent</span>
        </div>

        <div class="agent-summary__row">
            <span class="agent-summary__label">Account Status</span>
            <span class="agent-summary__value agent-summary__value--active">
                Active
            </span>
        </div>

        <div class="agent-summary__row">
            <span class="agent-summary__label">Access Level</span>
            <span class="agent-summary__value">Standard</span>
        </div>

        <div class="agent-summary__row">
            <span class="agent-summary__label">Last Login</span>
            <span class="agent-summary__value">—</span>
        </div>
    </section>

    <!-- Notes -->
    <section class="agent-summary agent-summary--muted">
        <p class="agent-summary__note">
            This account allows you to manage travel packages and bookings within the system.
            Contact an administrator if any account details are incorrect.
        </p>
    </section>

</div>
