@model TourismWebsiteAssignment.Models.TravelPackage

@{
    ViewBag.Title = "Package Details";
}
<link rel="stylesheet" href="~/Content/CustomStyles/Details.css" />

<section class="details-page">

    <header class="details-page__header">
        <div>
            <h2 class="details-page__title">Package Details</h2>
            <p class="details-page__subtitle">Review the travel package information below.</p>
        </div>
    </header>

    <div class="details-card">
        <div class="details-card__body">

            <dl class="details-list">

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.TravelAgency.AgencyName)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.TravelAgency.AgencyName)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.PackageTitle)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.PackageTitle)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.PackageDescription)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.PackageDescription)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.Destination)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.Destination)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.PricePerPerson)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.PricePerPerson)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.GroupMaxSize)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.GroupMaxSize)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.Inclusions)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.Inclusions)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.Exclusions)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.Exclusions)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.ItineraryDetails)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.ItineraryDetails)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.TermsAndConditions)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.TermsAndConditions)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.CreatedAt)</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
                    <dd class="details-value">@Html.DisplayFor(m => m.UpdatedAt)</dd>
                </div>

            </dl>

        </div>

        <div class="details-card__footer">
            <a class="btn btn--primary" href="@Url.Action("Edit", new { id = Model.PackageId })">Edit</a>
        </div>
    </div>

</section>
