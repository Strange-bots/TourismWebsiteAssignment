@model TourismWebsiteAssignment.Models.TourDate

@{
    ViewBag.Title = "Delete Tour Date";
}
<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />
<link rel="stylesheet" href="~/Content/CustomStyles/global-pages.css" />
<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">Delete Tour Date</h2>
            <p class="page-subtitle">Please confirm before permanently deleting this tour date.</p>
        </div>
    </header>

    <article class="card" style="max-width: 720px;">
        <div class="card-header">
            <div>
                <h3 class="card-title">Are you sure?</h3>
                <p class="card-meta">
                    This action cannot be undone.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="kv">
                <span class="kv__k">Package</span>
                <span class="kv__v">@Model.TravelPackage.PackageTitle</span>
            </div>

            <div class="kv">
                <span class="kv__k">Start Date</span>
                <span class="kv__v">@Model.StartDate</span>
            </div>

            <div class="kv">
                <span class="kv__k">End Date</span>
                <span class="kv__v">@Model.EndDate</span>
            </div>

            <div class="kv">
                <span class="kv__k">Available Slots</span>
                <span class="kv__v">@Model.AvailableSlots</span>
            </div>

            <div class="kv">
                <span class="kv__k">Total Slots</span>
                <span class="kv__v">@Model.TotalSlots</span>
            </div>

            <div class="kv">
                <span class="kv__k">Status</span>
                <span class="kv__v">@Model.Status</span>
            </div>

            <div class="kv">
                <span class="kv__k">Price Adjustment</span>
                <span class="kv__v">@Model.PriceAdjustment</span>
            </div>

        </div>

        <footer class="card-footer">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <a href="@Url.Action("AgentMyTours")" class="btn btn-ghost" style="margin-right:10px;">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            }
        </footer>
    </article>

</section>
