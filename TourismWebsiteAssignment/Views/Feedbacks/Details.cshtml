@model TourismWebsiteAssignment.Models.Feedback

@{
    ViewBag.Title = "Feedback Details";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-list.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">Feedback Details</h2>
            <p class="page-subtitle">View the full rating and comment.</p>
        </div>

        <div class="page-actions">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-ghost" })
            @Html.ActionLink("Edit", "Edit", new { id = Model.FeedbackId }, new { @class = "btn btn-primary" })
        </div>
    </header>

    @{
        var name = Model.Tourist != null ? (Model.Tourist.FullName ?? "N/A") : "N/A";
        var special = Model.Booking != null ? (Model.Booking.SpecialStatus ?? "") : "";
        var rating = Model.Rating;
        var dateText = Model.SubmittedAt.ToString("dd MMM yyyy");
    }

    <article class="card" style="grid-column: span 12;">
        <div class="card-header">
            <div>
                <h3 class="card-title">@name</h3>
                <p class="card-meta">
                    <span class="muted">Submitted: @dateText</span>
                </p>
            </div>

            <div class="rating" aria-label="Rating @rating out of 5">
                <span class="stars" data-rating="@rating">
                    <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
                </span>
                <span class="rating-num">@rating/5</span>
            </div>
        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(special))
            {
                <div class="kv kv--full">
                    <span class="kv__k">Special Status</span>
                    <span class="kv__v">@special</span>
                </div>
            }

            <div class="kv kv--full">
                <span class="kv__k">Comment</span>
                <span class="kv__v">@Model.Comments</span>
            </div>

        </div>

        <footer class="card-footer">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-ghost" })
            @Html.ActionLink("Edit", "Edit", new { id = Model.FeedbackId }, new { @class = "btn btn-primary" })
        </footer>
    </article>

</section>
