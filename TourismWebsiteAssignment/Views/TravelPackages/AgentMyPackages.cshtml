@model IEnumerable<TourismWebsiteAssignment.Models.TravelPackage>

@{
    ViewBag.Title = "Packages";
    var agencyName = Model?.FirstOrDefault().TravelAgency?.AgencyName;
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">
                @(string.IsNullOrWhiteSpace(agencyName) ? "Packages" : $"{agencyName}, List of Packages")
            </h2>
            <p class="page-subtitle">List of travel packages</p>
        </div>

        <div class="page-actions">
            <a class="btn btn-primary" href="@Url.Action("Create")">Create New</a>
        </div>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="grid">
            @foreach (var item in Model)
            {
                <article class="card">
                    @if (item.PackageImages != null && item.PackageImages.Any())
                    {
                        <div class="card-image">
                            <img src="@item.PackageImages.OrderByDescending(i => i.UploadedAt).First().ImageURL"
                                 alt="@item.PackageTitle"
                                 loading="lazy" />
                        </div>
                    }
                    else
                    {
                        <div class="card-image card-image--placeholder">
                            <span>No image</span>
                        </div>
                    }

                    <div class="card-header">
                        <div>
                            <h3 class="card-title">@item.PackageTitle</h3>
                            <p class="card-meta">
                                <span class="badge">@item.Destination</span>
                                <span class="separator">•</span>
                                <span class="muted">Max @item.GroupMaxSize</span>
                            </p>
                        </div>

                        <div class="price">
                            <span class="price-label">Price</span>
                            <span class="price-value">
                                @String.Format("{0:C}", item.PricePerPerson)
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="field field-full">
                            <span class="field-label">Description</span>
                            <span class="field-value clamp-3">@item.PackageDescription</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Inclusions</span>
                            <span class="field-value clamp-2">@item.Inclusions</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Exclusions</span>
                            <span class="field-value clamp-2">@item.Exclusions</span>
                        </div>

                        <!-- ADDED (from original table) -->
                        <div class="field field-full">
                            <span class="field-label">Itinerary</span>
                            <span class="field-value clamp-2">@item.ItineraryDetails</span>
                        </div>

                        <!-- ADDED (from original table) -->
                        <div class="field field-full">
                            <span class="field-label">Terms &amp; Conditions</span>
                            <span class="field-value clamp-2">@item.TermsAndConditions</span>
                        </div>
                    </div>

                    <footer class="card-footer">
                        <a class="btn btn-ghost"
                           href="@Url.Action("Create", "TourDates", new { packageId = item.PackageId })">
                            Add Date
                        </a>
                        <a class="btn btn-ghost" href="@Url.Action("Details", new { id = item.PackageId })">Details</a>
                        <a class="btn btn-ghost" href="@Url.Action("Edit", new { id = item.PackageId })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.PackageId })">Delete</a>
                    </footer>

                </article>
            }
        </div>
    }
    else
    {
        <div class="empty">
            <h3>No items found</h3>
            <p>Create a record to get started.</p>
        </div>
    }

</section>
