@model IEnumerable<TourismWebsiteAssignment.Models.TourDate>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TravelPackage.PackageTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StartDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EndDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AvailableSlots)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalSlots)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PriceAdjustment)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TravelPackage.PackageTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AvailableSlots)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalSlots)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PriceAdjustment)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.TourDateId }) |
                @Html.ActionLink("Details", "Details", new { id = item.TourDateId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.TourDateId })
            </td>
        </tr>
    }

</table>
