@model TourismWebsiteAssignment.Models.TourDate

@{
    ViewBag.Title = "Create Tour Date";
}

<link rel="stylesheet" href="~/Content/CustomStyles/CreateUser.css" />

<section class="auth-card">
    <header class="auth-header">
        <h2>Create Tour Date</h2>
        <p class="auth-subtitle">Add a schedule window, capacity, and pricing adjustment for this package.</p>
    </header>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "form-error" })

        <!-- PackageId (Hidden) -->
        @Html.HiddenFor(m => m.PackageId)
        @Html.ValidationMessageFor(m => m.PackageId, "", new { @class = "field-error" })

        <!-- Start Date -->
        <div class="form-field">
            @Html.LabelFor(m => m.StartDate)
            @Html.TextBoxFor(m => m.StartDate, new { @class = "form-input", type = "date" })
            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "field-error" })
        </div>

        <!-- End Date -->
        <div class="form-field">
            @Html.LabelFor(m => m.EndDate)
            @Html.TextBoxFor(m => m.EndDate, new { @class = "form-input", type = "date" })
            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "field-error" })
        </div>

        <!-- Available Slots -->
        <div class="form-field">
            @Html.LabelFor(m => m.AvailableSlots)
            @Html.TextBoxFor(m => m.AvailableSlots, new { @class = "form-input", type = "number", min = "0", step = "1", placeholder = "e.g., 15" })
            @Html.ValidationMessageFor(m => m.AvailableSlots, "", new { @class = "field-error" })
        </div>

        <!-- Total Slots -->
        <div class="form-field">
            @Html.LabelFor(m => m.TotalSlots)
            @Html.TextBoxFor(m => m.TotalSlots, new { @class = "form-input", type = "number", min = "0", step = "1", placeholder = "e.g., 20" })
            @Html.ValidationMessageFor(m => m.TotalSlots, "", new { @class = "field-error" })
        </div>

        <!-- Status -->
        <div class="form-field">
            @Html.LabelFor(m => m.Status)

            @* If Status is string/int, TextBox works.
                If you want a dropdown (Recommended), replace with DropDownListFor using ViewBag.StatusList. *@
            @Html.TextBoxFor(m => m.Status, new { @class = "form-input", placeholder = "e.g., Open" })
            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "field-error" })
        </div>

        <!-- Price Adjustment -->
        <div class="form-field">
            @Html.LabelFor(m => m.PriceAdjustment)
            @Html.TextBoxFor(m => m.PriceAdjustment, new { @class = "form-input", type = "number", step = "0.01", placeholder = "e.g., 25.00 (optional)" })
            @Html.ValidationMessageFor(m => m.PriceAdjustment, "", new { @class = "field-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Tour Date</button>
        </div>
    }

    <footer class="auth-footer">
        <a class="link-muted"
           href="@Url.Action("Create", "TravelPackages", new { id = Model.PackageId })">
            Back to Package
        </a>
    </footer>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
