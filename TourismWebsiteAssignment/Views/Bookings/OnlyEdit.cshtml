@model IEnumerable<TourismWebsiteAssignment.Models.Booking>

@{
    ViewBag.Title = "Bookings";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">Bookings</h2>
            <p class="page-subtitle">All booking records with status, tour date, customer, guests, and total.</p>
        </div>

        <div class="page-actions">
            @* Optional action buttons can go here *@
            @* <a class="btn btn-primary" href="@Url.Action("Create")">Create Booking</a> *@
        </div>
    </header>

    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <h3>No bookings found</h3>
            <p>Once bookings are created, they will appear here.</p>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var item in Model)
            {
                <article class="card">
                    <header class="card-header">
                        <div>
                            <h3 class="card-title">Booking #@item.BookingId</h3>
                            <p class="card-meta">
                                <span class="pill">@item.BookingStatus.StatusName</span>
                                <span class="separator">•</span>
                                <span class="muted">@item.BookingDate.ToString("dd MMM yyyy")</span>
                            </p>
                        </div>

                        <div class="price">
                            <span class="price-label">Total</span>
                            <span class="price-value">$@item.TotalPrice</span>
                        </div>
                    </header>

                    <div class="card-body">
                        <div class="field">
                            <span class="field-label">Tour Date</span>
                            <span class="field-value">@item.TourDate.Status</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Tourist</span>
                            <span class="field-value">@item.Tourist.FullName</span>
                        </div>

                        <div class="field">
                            <span class="field-label">Guests</span>
                            <span class="field-value">@item.NumberOfGuests</span>
                        </div>

                        <div class="field field-full">
                            <span class="field-label">Special Status</span>
                            <span class="field-value clamp-2">@item.SpecialStatus</span>
                        </div>
                    </div>

                    <footer class="card-footer">
                        <a class="btn btn-ghost" href="@Url.Action("Details", new { id = item.BookingId })">Details</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.BookingId })">Delete</a>
                    </footer>
                </article>
            }
        </div>
    }

</section>
