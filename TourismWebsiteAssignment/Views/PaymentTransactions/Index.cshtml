@model IEnumerable<TourismWebsiteAssignment.Models.PaymentTransactions>

@{
    ViewBag.Title = "Payment Transactions";
}

<h2>Payment Transactions</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<table class="table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Booking.SpecialStatus)</th>
        <th>@Html.DisplayNameFor(model => model.TransactionDate)</th>
        <th>@Html.DisplayNameFor(model => model.Amount)</th>
        <th>@Html.DisplayNameFor(model => model.PaymentMethod)</th>
        <th>@Html.DisplayNameFor(model => model.TransactionStatus)</th>
        <th>@Html.DisplayNameFor(model => model.TransactionReference)</th>
        <th>@Html.DisplayNameFor(model => model.Currency)</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Booking.SpecialStatus)</td>
            <td>@Html.DisplayFor(modelItem => item.TransactionDate)</td>
            <td>@Html.DisplayFor(modelItem => item.Amount)</td>
            <td>@Html.DisplayFor(modelItem => item.PaymentMethod)</td>
            <td>@Html.DisplayFor(modelItem => item.TransactionStatus)</td>
            <td>@Html.DisplayFor(modelItem => item.TransactionReference)</td>
            <td>@Html.DisplayFor(modelItem => item.Currency)</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.TransactionId }) |
                @Html.ActionLink("Details", "Details", new { id = item.TransactionId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.TransactionId })
            </td>
        </tr>
    }
</table>
