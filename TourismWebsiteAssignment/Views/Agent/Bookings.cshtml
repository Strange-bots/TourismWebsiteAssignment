@{
    ViewBag.Title = "Bookings";
}
<div class="dashboard-section">

    <h2>Bookings</h2>
    <p class="section-subtitle">Manage and track all customer bookings</p>

    <div class="table-container">
        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Tourist Name</th>
                    <th>Package</th>
                    <th>Tour Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>#1001</td>
                    <td>John Smith</td>
                    <td>Bali Getaway</td>
                    <td>12 Jan 2026</td>
                    <td><span class="status pending">Pending</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Update</button>
                    </td>
                </tr>

                <tr>
                    <td>#1002</td>
                    <td>Anna Lee</td>
                    <td>Nepal Trek</td>
                    <td>18 Jan 2026</td>
                    <td><span class="status confirmed">Confirmed</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Update</button>
                    </td>
                </tr>

                <tr>
                    <td>#1003</td>
                    <td>Michael Brown</td>
                    <td>Japan Explorer</td>
                    <td>25 Jan 2026</td>
                    <td><span class="status cancelled">Cancelled</span></td>
                    <td>
                        <button class="btn btn-view">View</button>
                        <button class="btn btn-edit">Update</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>
