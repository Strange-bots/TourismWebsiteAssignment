@model TourismWebsiteAssignment.Models.TravelAgency

@{
    ViewBag.Title = "Delete";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Delete.css" />
<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<h2>Delete</h2>

<div class="card--danger" style="background:#fff; border-radius:16px; padding:20px;">

    <div class="alert alert-danger">
        Are you sure you want to delete this Travel Agency?
        <span class="alert-badge">Permanent</span>
    </div>

    <dl class="details">

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.User.FullName)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.User.FullName)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.AgencyName)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.AgencyName)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.LicenseNumber)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.LicenseNumber)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.ContactNumber)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.ContactNumber)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.AgencyAddress)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.AgencyAddress)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.ContactPerson)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.ContactPerson)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.PhoneNumber)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.PhoneNumber)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.AgencyDescription)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.AgencyDescription)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.CreatedAt)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.UpdatedAt)</dd>
        </div>

        <div class="details-row">
            <dt class="details-label">@Html.DisplayNameFor(m => m.LogoUrl)</dt>
            <dd class="details-value">@Html.DisplayFor(m => m.LogoUrl)</dd>
        </div>

    </dl>

    <div style="margin-top:16px; display:flex; gap:10px; align-items:center;">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Delete" class="btn btn-danger" />
        }

        @if (User.IsInRole("Agent"))
        {
            @Html.ActionLink(
                "Cancel",
                "AgentMyAgency",
                "Agencies",
                null,
                new { @class = "btn btn-secondary" }
            )
        }
        else if (User.IsInRole("Admin"))
        {
            @Html.ActionLink(
                "Cancel",
                "OnlyEdit",
                null,
                new { @class = "btn btn-secondary" }
            )
        }

    </div>

</div>
