@model TourismWebsiteAssignment.Models.Booking

@{
    ViewBag.Title = "Edit Booking";
}
<link rel="stylesheet" href="~/Content/CustomStyles/Edit.css" />
<section class="admin-page">

    <!-- Page Header -->
    <header class="admin-page__header">
        <div>
            <h1 class="admin-page__title">Edit Booking</h1>
            <p class="admin-page__subtitle">Update booking details, status, and pricing</p>
        </div>
    </header>

    <!-- Card -->
    <div class="admin-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title">Booking Details</h2>
            <p class="admin-card__hint">Review fields carefully before saving changes</p>
        </div>

        <div class="admin-card__body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "form-error-summary" })
                @Html.HiddenFor(m => m.BookingId)

            <div class="form-grid">
                @Html.HiddenFor(m => m.TouristProfileId)
                @Html.HiddenFor(m => m.TourDateId)
                <!-- Booking Status -->
                <div class="form-field">
                    @Html.LabelFor(m => m.BookingStatusId, "Booking Status", new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.BookingStatusId, (SelectList)ViewBag.BookingStatusId, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.BookingStatusId, "", new { @class = "form-error" })
                </div>

                <!-- Booking Date -->
                <div class="form-field">
                    @Html.LabelFor(m => m.BookingDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.BookingDate, "{0:yyyy-MM-dd}", new { @class = "form-input", type = "date" })
                    @Html.ValidationMessageFor(m => m.BookingDate, "", new { @class = "form-error" })
                </div>

                <!-- Guests -->
                <div class="form-field">
                    @Html.LabelFor(m => m.NumberOfGuests, new { @class = "form-label" })
                    @Html.EditorFor(m => m.NumberOfGuests, new { htmlAttributes = new { @class = "form-input" } })
                    @Html.ValidationMessageFor(m => m.NumberOfGuests, "", new { @class = "form-error" })
                </div>

                <!-- Total Price -->
                <div class="form-field">
                    @Html.LabelFor(m => m.TotalPrice, new { @class = "form-label" })
                    @Html.EditorFor(m => m.TotalPrice, new { htmlAttributes = new { @class = "form-input" } })
                    @Html.ValidationMessageFor(m => m.TotalPrice, "", new { @class = "form-error" })
                </div>

                <!-- Special Status -->
                <div class="form-field">
                    @Html.LabelFor(m => m.SpecialStatus, new { @class = "form-label" })
                    @Html.EditorFor(m => m.SpecialStatus, new { htmlAttributes = new { @class = "form-input" } })
                    @Html.ValidationMessageFor(m => m.SpecialStatus, "", new { @class = "form-error" })
                </div>

            </div>

                <!-- Actions -->
                <div class="form-actions">
                    <a href="@Url.Action("AgentMyBookingsOnlyView")" class="btn btn--ghost">Cancel</a>
                    <button type="submit" class="btn btn--primary">Save Changes</button>
                </div>
            }

        </div>
    </div>

</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
