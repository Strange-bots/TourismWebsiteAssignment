@{
    ViewBag.Title = "Admin Home";
}

<style>
    .admin-account-basic {
        max-width: 720px;
        margin: 0 auto;
        padding: 24px;
    }

    .admin-account-basic__header {
        margin-bottom: 22px;
    }

    .admin-account-basic__title {
        font-size: 1.6rem;
        margin-bottom: 4px;
    }

    .admin-account-basic__subtitle {
        font-size: 0.95rem;
        color: #666;
    }

    /* Summary box */
    .admin-summary {
        background: #ffffff;
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }

    .admin-summary--muted {
        background: #fafafa;
    }

    .admin-summary__title {
        font-size: 1.05rem;
        margin: 0 0 12px 0;
    }

    /* Rows */
    .admin-summary__row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

        .admin-summary__row:last-child {
            border-bottom: none;
        }

    .admin-summary__label {
        color: #777;
        font-size: 0.9rem;
    }

    .admin-summary__value {
        font-weight: 600;
        color: #333;
    }

    /* Status */
    .admin-summary__value--online {
        color: #2e7d32;
    }

    /* Notes */
    .admin-notes {
        margin: 0;
        padding-left: 18px;
    }

        .admin-notes li {
            margin-bottom: 8px;
            color: #555;
            line-height: 1.5;
        }

</style>

<div class="admin-account-basic">

    <!-- Header -->
    <header class="admin-account-basic__header">
        <h2 class="admin-account-basic__title">Admin Dashboard</h2>
        <p class="admin-account-basic__subtitle">
            Basic system and account information.
        </p>
    </header>

    <!-- Account / System Summary -->
    <section class="admin-summary">
        <div class="admin-summary__row">
            <span class="admin-summary__label">Role</span>
            <span class="admin-summary__value">Admin</span>
        </div>

        <div class="admin-summary__row">
            <span class="admin-summary__label">System Status</span>
            <span class="admin-summary__value admin-summary__value--online">Online</span>
        </div>

        <div class="admin-summary__row">
            <span class="admin-summary__label">Access Level</span>
            <span class="admin-summary__value">Full Control</span>
        </div>

        <div class="admin-summary__row">
            <span class="admin-summary__label">Last Review</span>
            <span class="admin-summary__value">—</span>
        </div>
    </section>

    <!-- Notes -->
    <section class="admin-summary admin-summary--muted">
        <h3 class="admin-summary__title">System Notes</h3>
        <ul class="admin-notes">
            <li>Verify role assignments before granting access.</li>
            <li>Monitor booking failures and mismatches daily.</li>
            <li>Review feedback weekly and resolve repeated complaints.</li>
        </ul>
    </section>

</div>
