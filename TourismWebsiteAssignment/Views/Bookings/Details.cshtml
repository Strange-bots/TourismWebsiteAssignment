@model TourismWebsiteAssignment.Models.Booking

@{
    ViewBag.Title = "Booking Details";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Details.css" />

<section class="details-page">

    <!-- Header -->
    <header class="details-page__header">
        <div>
            <h1 class="details-page__title">Booking Details</h1>
            <p class="details-page__subtitle">View booking status, tourist info, and pricing.</p>
        </div>
    </header>

    <!-- Card -->
    <article class="details-card" style="max-width: 820px;">

        <div class="details-card__body">
            <div class="details-list">

                <div class="details-row">
                    <div class="details-label">Booking #</div>
                    <div class="details-value">
                        @Model.BookingId
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Booking Status</div>
                    <div class="details-value">
                        <span class="badge badge--role">
                            @Model.BookingStatus.StatusName
                        </span>
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Booking Date</div>
                    <div class="details-value">
                        @Model.BookingDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Total Price</div>
                    <div class="details-value">
                        $@Model.TotalPrice
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Tour Status</div>
                    <div class="details-value">
                        @Model.TourDate.Status
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Tourist</div>
                    <div class="details-value">
                        @Model.Tourist.FullName
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Guests</div>
                    <div class="details-value">
                        @Model.NumberOfGuests
                    </div>
                </div>

                <div class="details-row">
                    <div class="details-label">Special Status</div>
                    <div class="details-value">
                        @if (!string.IsNullOrWhiteSpace(Model.SpecialStatus))
                        {
                            @Model.SpecialStatus
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>
                </div>

            </div>
        </div>

        <footer class="details-card__footer">
        </footer>

    </article>

</section>
