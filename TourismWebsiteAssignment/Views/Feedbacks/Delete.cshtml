@model TourismWebsiteAssignment.Models.Feedback

@{
    ViewBag.Title = "Delete Feedback";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Delete.css" />

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />


<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">Delete Feedback</h2>
            <p class="page-subtitle">This action cannot be undone.</p>
        </div>

        <div class="page-actions">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-ghost" })
        </div>
    </header>

    <div class="grid">
        <article class="card card--danger">

            <div class="card-body">

                <!-- Warning -->
                <div class="alert alert-danger">
                    <span class="alert-badge">Warning</span>
                    You are about to permanently delete this feedback.
                </div>

                <!-- Details -->
                <div class="details">

                    <div class="details-row">
                        <span class="details-label">Tourist</span>
                        <span class="details-value">
                            @(Model.Tourist?.FullName ?? "N/A")
                        </span>
                    </div>

                    <div class="details-row">
                        <span class="details-label">Rating</span>
                        <span class="details-value">
                            @Model.Rating / 5
                        </span>
                    </div>

                    <div class="details-row">
                        <span class="details-label">Comment</span>
                        <span class="details-value">
                            @Model.Comments
                        </span>
                    </div>

                    <div class="details-row">
                        <span class="details-label">Submitted At</span>
                        <span class="details-value">
                            @Model.SubmittedAt.ToString("dd MMM yyyy")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Booking?.SpecialStatus))
                    {
                        <div class="details-row">
                            <span class="details-label">Special Status</span>
                            <span class="details-value">
                                @Model.Booking.SpecialStatus
                            </span>
                        </div>
                    }

                </div>

            </div>

            <footer class="card-footer">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        Delete Permanently
                    </button>
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-ghost" })
                }
            </footer>

        </article>
    </div>

</section>
