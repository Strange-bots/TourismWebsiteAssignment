    <nav class="navbar navbar-dark bg-dark">
        <div class="container d-flex align-items-center">

            <!-- Hamburger (ALWAYS visible) -->
            <button class="navbar-toggler me-2" type="button"
                    data-bs-toggle="collapse" data-bs-target="#hamburgerMenu"
                    aria-controls="hamburgerMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Logo -->
            <div class="navbar-brand m-0">
                YourLogo
            </div>

            <!-- Spacer -->
            <div class="flex-grow-1"></div>

            <!-- Search bar (ALWAYS visible, outside hamburger) -->
            <form class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Search..." aria-label="Search">
                <button class="btn btn-outline-light" type="submit">Search</button>
            </form>

        </div>

        <!-- Collapsible Hamburger Menu -->
        <div class="collapse bg-dark" id="hamburgerMenu">
            <ul class="navbar-nav px-3 py-2">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/Home/About">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/Home/Contact">Contact</a>
                </li>
            </ul>
        </div>
    </nav>


    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
