@model IEnumerable<TourismWebsiteAssignment.Models.TravelAgency>

@{
    ViewBag.Title = "Agencies";
}
<link rel="stylesheet" href="~/Content/CustomStyles/ViewAgency.css"
<section class="admin-page">

    <header class="admin-header">
        <div>
            <h2 class="admin-title">List of Agencies</h2>
            <p class="admin-subtitle">Manage travel agencies and view their details.</p>
        </div>
    </header>

    <div class="card-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var a in Model)
            {
                <article class="entity-card">

                    <div class="entity-card__top">
                        <div>
                            <h3 class="entity-card__title">@a.AgencyName</h3>
                            <p class="entity-card__meta">
                                <span class="pill">@a.LicenseNumber</span>
                                <span class="dot">•</span>
                                <span class="muted">Owner: @a.User?.FullName</span>
                            </p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(a.LogoUrl))
                        {
                            <img class="entity-card__logo" src="@a.LogoUrl" alt="Agency logo" />
                        }
                        else
                        {
                            <div class="entity-card__logo entity-card__logo--placeholder">
                                @(string.IsNullOrWhiteSpace(a.AgencyName) ? "A" : a.AgencyName.Trim().Substring(0, 1).ToUpper())
                            </div>
                        }
                    </div>

                    <div class="entity-card__body">
                        <div class="kv">
                            <span class="kv__k">Contact</span>
                            <span class="kv__v">@a.ContactNumber</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Phone</span>
                            <span class="kv__v">@a.PhoneNumber</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Address</span>
                            <span class="kv__v">@a.AgencyAddress</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Description</span>
                            <span class="kv__v clamp-3">@a.AgencyDescription</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Created</span>
                            <span class="kv__v">@a.CreatedAt.ToString("yyyy-MM-dd")</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Contact Person</span>
                            <span class="kv__v">@a.ContactPerson</span>
                        </div>
                    </div>

                    <footer class="entity-card__footer">
                        <a class="btn btn--ghost" href="@Url.Action("Details", new { id = a.AgencyId })">Details</a>
                        <a class="btn btn--ghost" href="@Url.Action("Edit", new { id = a.AgencyId })">Edit</a>
                        <a class="btn btn--danger" href="@Url.Action("Delete", new { id = a.AgencyId })">Delete</a>
                    </footer>

                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <h3 class="empty-state__title">No agencies found</h3>
                <p class="empty-state__text">Add an agency to see it listed here.</p>
            </div>
        }
    </div>

</section>
