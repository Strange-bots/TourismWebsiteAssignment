<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Tourist</title>

    <link href="~/Content/dashboard.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="dashboard-wrapper">
        <div class="top-bar">
            <img src="" alt="logo" />
            <img src="" alt="profile" />
        </div>

        <div class="sidebar">
            @Html.Partial("_TouristNav")
        </div>

        <div class="main-content">
            <div class="content-card">
                @RenderBody()
            </div>
        </div>

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
