@model IEnumerable<TourismWebsiteAssignment.Models.User>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">User Management</h2>
            <p class="page-subtitle">View and manage system users.</p>
        </div>

        <div class="page-actions">
            @Html.ActionLink("Create New User", "Create", null, new { @class = "btn btn-primary" })
        </div>
    </header>

    <div class="grid">
        @if (Model != null && Model.Any())
        {
            foreach (var u in Model)
            {
                var initial = string.IsNullOrWhiteSpace(u.FullName)
                    ? "U"
                    : u.FullName.Trim().Substring(0, 1).ToUpper();

                <article class="card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">@u.FullName</h3>
                            <p class="card-meta">
                                <span class="muted">@u.Username</span>
                            </p>
                        </div>

                        <span class="muted">User</span>
                    </div>

                    <div class="card-body">
                        <div class="kv">
                            <span class="kv__k">Email</span>
                            <span class="kv__v">@u.Email</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Username</span>
                            <span class="kv__v">@u.Username</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Password</span>
                            <span class="kv__v muted">Hidden</span>
                        </div>
                    </div>

                    <footer class="card-footer">
                        <a class="btn btn-ghost" href="@Url.Action("Details", new { id = u.UserId })">Details</a>
                        <a class="btn btn-ghost" href="@Url.Action("Edit", new { id = u.UserId })">Edit</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = u.UserId })">Delete</a>
                    </footer>
                </article>
            }
        }
        else
        {
            <div class="empty">
                <h3>No users found</h3>
                <p>Create a user to see it listed here.</p>
            </div>
        }
    </div>

</section>
