@model IEnumerable<TourismWebsiteAssignment.Models.TravelPackage>

@{
    ViewBag.Title = "Browse Trips";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/CustomStyles/Browse.css" />

<section class="browse-page">

    <!-- Hero -->
    <header class="browse-hero">
        <div class="browse-hero__content">
            <h1 class="browse-title">Browse Travel Experiences</h1>
            <p class="browse-subtitle">
                Discover curated tours, compare destinations, and book with confidence.
            </p>
        </div>
    </header>

    <!-- Results -->
    <div class="browse-container">

        @if (Model != null && Model.Any())
        {
            <div class="browse-grid">
                @foreach (var pkg in Model)
                {
                    var latestImg = (pkg.PackageImages != null && pkg.PackageImages.Any())
                        ? pkg.PackageImages.OrderByDescending(i => i.UploadedAt).FirstOrDefault()
                        : null;

                    var imageUrl = latestImg?.ImageURL;

                    <article class="browse-card">

                        <!-- Image -->
                        <div class="browse-card__image">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl"
                                     alt="@pkg.PackageTitle"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="browse-card__placeholder">
                                    No Image
                                </div>
                            }
                        </div>

                        <!-- Content -->
                        <div class="browse-card__content">
                            <h3 class="browse-card__title">@pkg.PackageTitle</h3>

                            <p class="browse-card__meta">
                                @if (!string.IsNullOrWhiteSpace(pkg.Destination))
                                {
                                    <span class="tag">@pkg.Destination</span>
                                }
                                <span>• Group up to @pkg.GroupMaxSize</span>
                            </p>

                            <p class="browse-card__desc">
                                @pkg.PackageDescription
                            </p>
                        </div>

                        <!-- Footer -->
                        <div class="browse-card__footer">
                            <div class="browse-price">
                                <span>From</span>
                                <strong>$@pkg.PricePerPerson</strong>
                            </div>

                            <a class="browse-btn"
                               href="@Url.Action(
                                    "TouristCreateBookings",
                                    "Bookings",
                                    new { packageId = pkg.PackageId, returnUrl = Request.RawUrl }
                               )">
                                Book
                            </a>
                        </div>

                    </article>
                }
            </div>
        }
        else
        {
            <div class="browse-empty">
                <h3>No trips available</h3>
                <p>Please check back later.</p>
            </div>
        }

    </div>
</section>
