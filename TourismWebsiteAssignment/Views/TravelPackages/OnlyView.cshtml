@model IEnumerable<TourismWebsiteAssignment.Models.TravelPackage>

@{
    ViewBag.Title = "Packages";
    // If this is inside dashboard, set Layout as needed:
    // Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ViewPackage.css" />

<section class="admin-page">

    <header class="admin-header">
        <div>
            <h2 class="admin-title">List of Packages</h2>
            <p class="admin-subtitle">Browse and manage travel packages and their details.</p>
        </div>

        <div class="admin-actions">
            @* Optional *@
            @* @Html.ActionLink("Create New Package", "Create", null, new { @class = "btn btn--primary" }) *@
        </div>
    </header>

    <div class="card-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var p in Model)
            {
                <article class="entity-card">

                    <div class="entity-card__top">
                        <div>
                            <h3 class="entity-card__title">@p.PackageTitle</h3>

                            <p class="entity-card__meta">
                                <span class="pill">@p.Destination</span>

                                @if (p.TravelAgency != null && !string.IsNullOrWhiteSpace(p.TravelAgency.AgencyName))
                                {
                                    <span class="dot">•</span>
                                    <span class="muted">@p.TravelAgency.AgencyName</span>
                                }
                            </p>
                        </div>

                        <div class="entity-card__price">
                            <span class="price">
                                @String.Format("{0:C}", p.PricePerPerson)
                            </span>
                            <span class="muted small">per person</span>
                        </div>
                    </div>

                    <div class="entity-card__body">

                        <div class="kv kv--full">
                            <span class="kv__k">Description</span>
                            <span class="kv__v clamp-3">@p.PackageDescription</span>
                        </div>

                        <div class="kv">
                            <span class="kv__k">Group Size</span>
                            <span class="kv__v">@p.GroupMaxSize</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Inclusions</span>
                            <span class="kv__v clamp-3">@p.Inclusions</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Exclusions</span>
                            <span class="kv__v clamp-3">@p.Exclusions</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Itinerary</span>
                            <span class="kv__v clamp-3">@p.ItineraryDetails</span>
                        </div>

                        <div class="kv kv--full">
                            <span class="kv__k">Terms</span>
                            <span class="kv__v clamp-3">@p.TermsAndConditions</span>
                        </div>

                    </div>

                    <footer class="entity-card__footer">
                        <a class="btn btn--ghost" href="@Url.Action("Details", "TravelPackages", new { id = p.PackageId })">Details</a>
                        <a class="btn btn--ghost" href="@Url.Action("Edit", "TravelPackages", new { id = p.PackageId })">Edit</a>
                        <a class="btn btn--danger" href="@Url.Action("Delete", "TravelPackages", new { id = p.PackageId })">Delete</a>
                    </footer>

                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <h3 class="empty-state__title">No packages found</h3>
                <p class="empty-state__text">Create a package to see it listed here.</p>
            </div>
        }
    </div>

</section>
