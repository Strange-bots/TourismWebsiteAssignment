@model TourismWebsiteAssignment.Models.Feedback
<link rel="stylesheet" href="~/Content/CustomStyles/Feedback.css" />
<div class="feedback-form">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.BookingId)


        <div class="form-group">
            <label>Rating</label>

            <div class="rating-wrap">
                <div class="rating-stars" role="radiogroup" aria-label="Rating (1 to 5 stars)">
                    <input class="star-input" type="radio" id="star5" name="Rating" value="5" />
                    <label class="star" for="star5">★</label>

                    <input class="star-input" type="radio" id="star4" name="Rating" value="4" />
                    <label class="star" for="star4">★</label>

                    <input class="star-input" type="radio" id="star3" name="Rating" value="3" />
                    <label class="star" for="star3">★</label>

                    <input class="star-input" type="radio" id="star2" name="Rating" value="2" />
                    <label class="star" for="star2">★</label>

                    <input class="star-input" type="radio" id="star1" name="Rating" value="1" />
                    <label class="star" for="star1">★</label>
                </div>

                <span class="rating-hint">Select 1–5</span>
            </div>

            @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Comments)
            @Html.TextAreaFor(m => m.Comments, new { @class = "form-control", rows = 4 })
            @Html.ValidationMessageFor(m => m.Comments)
        </div>

        <input type="submit" value="Submit Feedback" class="btn btn-primary" />
    }
</div>
