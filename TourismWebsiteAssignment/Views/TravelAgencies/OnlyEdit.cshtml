@model IEnumerable<TourismWebsiteAssignment.Models.TravelAgency>

@{
    ViewBag.Title = "Agencies";
}

<link rel="stylesheet" href="~/Content/CustomStyles/ui-cards.css" />

<section class="page">

    <header class="page-header">
        <div>
            <h2 class="page-title">List of Agencies</h2>
            <p class="page-subtitle">Manage travel agencies and view their details.</p>
        </div>
    </header>

    <div class="grid">
        @if (Model != null && Model.Any())
        {
            foreach (var a in Model)
            {
                var agencyName = string.IsNullOrWhiteSpace(a.AgencyName) ? "Agency" : a.AgencyName.Trim();
                var ownerName = a.User != null && !string.IsNullOrWhiteSpace(a.User.FullName) ? a.User.FullName : "N/A";
                var initial = agencyName.Substring(0, 1).ToUpper();

                <article class="card">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title">@agencyName</h3>
                            <p class="card-meta">
                                @if (!string.IsNullOrWhiteSpace(a.LicenseNumber))
                                {
                                    <span class="pill">@a.LicenseNumber</span>
                                }
                                <span class="separator">•</span>
                                <span class="muted">Owner: @ownerName</span>
                            </p>
                        </div>
                    </div>

                    <div class="card-body">

                        @if (!string.IsNullOrWhiteSpace(a.ContactNumber))
                        {
                            <div class="kv">
                                <span class="kv__k">Contact</span>
                                <span class="kv__v">@a.ContactNumber</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(a.PhoneNumber))
                        {
                            <div class="kv">
                                <span class="kv__k">Phone</span>
                                <span class="kv__v">@a.PhoneNumber</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(a.AgencyAddress))
                        {
                            <div class="kv kv--full">
                                <span class="kv__k">Address</span>
                                <span class="kv__v">@a.AgencyAddress</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(a.AgencyDescription))
                        {
                            <div class="kv kv--full">
                                <span class="kv__k">Description</span>
                                <span class="kv__v clamp-3">@a.AgencyDescription</span>
                            </div>
                        }

                        <div class="kv">
                            <span class="kv__k">Created</span>
                            <span class="kv__v">@a.CreatedAt.ToString("yyyy-MM-dd")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(a.ContactPerson))
                        {
                            <div class="kv">
                                <span class="kv__k">Contact Person</span>
                                <span class="kv__v">@a.ContactPerson</span>
                            </div>
                        }
                    </div>

                    <footer class="card-footer">
                        <a class="btn btn-ghost" href="@Url.Action("Details", "TravelAgencies", new { id = a.AgencyId })">Details</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", "TravelAgencies", new { id = a.AgencyId })">Delete</a>
                    </footer>

                </article>
            }
        }
        else
        {
            <div class="empty">
                <h3>No agencies found</h3>
                <p>Add an agency to see it listed here.</p>
            </div>
        }
    </div>

</section>
