@model TourismWebsiteAssignment.Models.TouristProfile

<link rel="stylesheet" href="~/Content/CustomStyles/tourist-home.css" />

<div class="tourist-dashboard">

    <!-- Header / Hero -->
    <header class="tourist-hero">
        <div class="tourist-hero__text">
            <h2 class="tourist-hero__title">Tourist Dashboard</h2>
            <p class="tourist-hero__subtitle">
                Welcome, @Model.FullName. Browse packages, manage your bookings, and track your travel plans.
            </p>
        </div>
        <div class="tourist-hero__meta">
            <div class="tourist-pill">Status: Active</div>
            <div class="tourist-pill tourist-pill--muted">Role: Tourist</div>
        </div>
    </header>

    <!-- Profile Summary -->
    <section class="tourist-panel">
        <div class="tourist-panel__header">
            <h3 class="tourist-panel__title">My Profile</h3>
            <p class="tourist-panel__hint">Your saved account information.</p>
        </div>

        <div class="tourist-grid tourist-grid--stats">
            <article class="tourist-card tourist-card--stat">
                <div class="tourist-card__top">
                    <span class="tourist-card__label">Account Name</span>
                </div>
                <div class="tourist-card__value">@Model.User.FullName</div>
                <div class="tourist-card__note">Login user</div>
            </article>

            <article class="tourist-card tourist-card--stat">
                <div class="tourist-card__top">
                    <span class="tourist-card__label">Gender</span>
                </div>
                <div class="tourist-card__value">@Model.Gender</div>
                <div class="tourist-card__note">Profile detail</div>
            </article>

            <article class="tourist-card tourist-card--stat">
                <div class="tourist-card__top">
                    <span class="tourist-card__label">Nationality</span>
                </div>
                <div class="tourist-card__value">@Model.Nationality</div>
                <div class="tourist-card__note">Profile detail</div>
            </article>

            <article class="tourist-card tourist-card--stat">
                <div class="tourist-card__top">
                    <span class="tourist-card__label">Date of Birth</span>
                </div>
                <div class="tourist-card__value">@Model.DateOfBirth.ToString("yyyy-MM-dd")</div>
                <div class="tourist-card__note">Profile detail</div>
            </article>
        </div>

        <div class="tourist-noteBox" style="margin-top:14px;">
            <ul class="tourist-noteBox__list">
                <li><strong>Address:</strong> @Model.Address</li>
                <li><strong>Travel Preferences:</strong> @Model.TravelPreferences</li>
                <li><strong>Profile Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd")</li>
                <li><strong>Last Updated:</strong> @Model.UpdatedAt.ToString("yyyy-MM-dd")</li>
            </ul>
        </div>
    </section>

    <!-- Notes -->
    <section class="tourist-panel tourist-panel--notes">
        <div class="tourist-panel__header">
            <h3 class="tourist-panel__title">Travel Notes</h3>
            <p class="tourist-panel__hint">Helpful reminders for a smooth trip.</p>
        </div>

        <div class="tourist-noteBox">
            <ul class="tourist-noteBox__list">
                <li>Review tour dates and inclusions before confirming your booking.</li>
                <li>Complete payments on time to avoid cancellation.</li>
                <li>Leave feedback after your trip to help other travelers.</li>
            </ul>
        </div>
    </section>

</div>
