@model TourismWebsiteAssignment.Models.User

@{
    ViewBag.Title = "User Details";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}
<link rel="stylesheet" href="~/Content/CustomStyles/Details.css" />
<section class="details-page">

    <!-- Page Header -->
    <header class="details-page__header">
        <div>
            <h2 class="details-page__title">User Details</h2>
            <p class="details-page__subtitle">View user information and assigned role</p>
        </div>

        <div class="details-page__actions">
            <a class="btn btn--ghost" href="@Url.Action("Index")">Back to List</a>
        </div>
    </header>

    <!-- Details Card -->
    <div class="details-card">
        <div class="details-card__body">

            <dl class="details-list">

                <div class="details-row">
                    <dt class="details-label">Role</dt>
                    <dd class="details-value">
                        <span class="badge badge--role">
                            @Model.Role?.RoleName
                        </span>
                    </dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">Full Name</dt>
                    <dd class="details-value">@Model.FullName</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">Email</dt>
                    <dd class="details-value">@Model.Email</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">Username</dt>
                    <dd class="details-value">@Model.Username</dd>
                </div>

                <div class="details-row">
                    <dt class="details-label">Password</dt>
                    <dd class="details-value text-muted">
                        @Model.Password
                    </dd>
                </div>

            </dl>

        </div>

        <!-- Card Footer -->
        <footer class="details-card__footer">
            <a class="btn btn--primary"
               href="@Url.Action("Edit", new { id = Model.UserId })">
                Edit User
            </a>
            <a class="btn btn--ghost"
               href="@Url.Action("Index")">
                Back
            </a>
        </footer>
    </div>

</section>
