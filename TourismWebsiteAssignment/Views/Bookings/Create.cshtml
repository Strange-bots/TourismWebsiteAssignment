@model TourismWebsiteAssignment.Models.Booking

@{
    ViewBag.Title = "Book Tour";
}

<link rel="stylesheet" href="~/Content/CustomStyles/BookingCreate.css" />
<section class="booking-page">
    <div class="booking-card">

        <header class="booking-header">
            <div>
                <h2 class="booking-title">Confirm Your Booking</h2>
                <p class="booking-subtitle">Select a date, guests, and add any special requests.</p>
            </div>
        </header>

        @using (Html.BeginForm("Create", "Bookings", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "val-summary" })

            <!-- SYSTEM FIELDS: do not ask user -->
            @* TouristProfileId should be set server-side in controller *@
            @Html.HiddenFor(m => m.BookingStatusId, new { @Value = ViewBag.DefaultBookingStatusId ?? 1 })
            @Html.HiddenFor(m => m.BookingDate, new { @Value = DateTime.Now.ToString("yyyy-MM-dd") })

            @* TotalPrice should be computed server-side.
                Keep it hidden; optionally show a readonly estimate. *@
            @Html.HiddenFor(m => m.TotalPrice)

            <!-- USER INPUTS -->
            <div class="form-grid">

                <div class="field">
                    @Html.LabelFor(m => m.TourDateId, "Tour Date", new { @class = "label" })
                    @Html.DropDownList("TourDateId", null, "Select a tour date", new { @class = "input" })
                    @Html.ValidationMessageFor(m => m.TourDateId, "", new { @class = "val" })
                </div>

                <div class="field">
                    @Html.LabelFor(m => m.NumberOfGuests, "Guests", new { @class = "label" })
                    @Html.TextBoxFor(m => m.NumberOfGuests, new { @class = "input", type = "number", min = "1", max = "100", value = "1" })
                    @Html.ValidationMessageFor(m => m.NumberOfGuests, "", new { @class = "val" })
                </div>

                <div class="field field--full">
                    @Html.LabelFor(m => m.SpecialStatus, "Special Requests", new { @class = "label" })
                    @Html.TextAreaFor(m => m.SpecialStatus, 4, 40, new { @class = "input input--textarea", placeholder = "Dietary requirements, accessibility needs, notes..." })
                    @Html.ValidationMessageFor(m => m.SpecialStatus, "", new { @class = "val" })
                </div>

            </div>

            <div class="actions">
                <button type="submit" class="btn btn--primary">Confirm Booking</button>
                <a href="@Url.Action("Index", "TravelPackages")" class="btn btn--ghost">Cancel</a>
            </div>
        }

    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
